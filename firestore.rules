rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Institution doc + ALL nested subcollections (campuses, interests, etc.)
    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if false;
    }

    match /institutions/{institutionId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts'])
          && request.resource.data.get(['counts', 'hosted'], 0) == resource.data.get(['counts', 'hosted'], 0)
          && request.resource.data.get(['counts', 'joined'], 0) == resource.data.get(['counts', 'joined'], 0)
          && (
            (
              request.resource.data.get(['counts', 'friends'], 0) == resource.data.get(['counts', 'friends'], 0) + 1
              && exists(/databases/$(database)/documents/users/$(userId)/connections/$(request.auth.uid))
            )
            ||
            (
              request.resource.data.get(['counts', 'friends'], 0) == resource.data.get(['counts', 'friends'], 0) - 1
              && request.resource.data.get(['counts', 'friends'], 0) >= 0
            )
          )
        )
      );
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['email', 'username', 'institution']);
      
      // Connections sub-collection
      match /connections/{targetUid} {
        allow read: if request.auth != null && (
          request.auth.uid == userId 
          || request.auth.uid == targetUid 
          || resource.data.status == 'connected'
        );
        
        allow create: if request.auth != null && (
          // Owner can create
          request.auth.uid == userId 
          || 
          // Peer can create a pending request initiated by themselves
          (request.auth.uid == targetUid && 
           request.resource.data.status == 'pending' && 
           request.resource.data.initiated_by == request.auth.uid)
        );
        
        allow update: if request.auth != null && (
          // Owner can update
          request.auth.uid == userId
          ||
          // Peer can update status to 'connected' only if the owner was the initiator
          (request.auth.uid == targetUid && 
           request.resource.data.status == 'connected' && 
           resource.data.status == 'pending' &&
           resource.data.initiated_by == userId &&
           request.resource.data.initiated_by == resource.data.initiated_by)
        );

        allow delete: if request.auth != null && (
          // Either party can delete (cancel request, unfriend, decline)
          request.auth.uid == userId || request.auth.uid == targetUid
        );
      }

      // Schedule sub-collection
      match /schedule/{eventId} {
        // Users can only read and write to their own schedule
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Events collection
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
